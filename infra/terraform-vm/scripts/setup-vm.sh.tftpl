#!/bin/bash
set -euo pipefail

apt-get update
apt-get install -y ca-certificates curl gnupg git jq
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable docker
systemctl start docker
usermod -aG docker azureuser || true

mkdir -p /opt/insurance
cd /opt/insurance

if [ ! -d .git ]; then
  git clone ${repo_url} /opt/insurance
else
  git -C /opt/insurance pull --ff-only || true
fi

cat > /opt/insurance/.env <<'EOF'
PORT=5000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=super-secret-change-me
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=insurance_db
AZURE_STORAGE_CONNECTION_STRING=${azure_storage_connection_string}
AZURE_BLOB_CONTAINER=${azure_blob_container}
AZURE_TEMP_BLOB_CONTAINER=${azure_temp_blob_container}
AZURE_SERVICEBUS_NAMESPACE=${azure_servicebus_namespace}
AZURE_SERVICEBUS_VALIDATION_QUEUE=${azure_servicebus_validation_queue}
AZURE_SERVICEBUS_NOTIFICATION_QUEUE=${azure_servicebus_notification_queue}
OCR_API_URL=${ocr_api_url}
OCR_API_KEY=${ocr_api_key}
EOF

cd /opt/insurance
# Start the stack with the existing docker-compose.yml from the repo.
docker compose up -d --build

echo "Docker Compose deployment finished."
